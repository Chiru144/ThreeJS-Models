  "description": "MCP server with an orchestrator of agents and sub-agents that plans, models, lights, animates, optimizes, generates and validates Three.js scenes.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "threejs-forge-mcp": "src/server.js",
    "threejs-forge-doctor": "bin/doctor.js"
  },
