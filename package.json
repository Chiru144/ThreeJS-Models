    "test": "node --test",
    "doctor": "node bin/doctor.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acorn": "^8.19.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  }
}
